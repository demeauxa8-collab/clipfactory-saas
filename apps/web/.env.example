# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=TODO
# Analytics — first-party tracking always works without these. Set to also mirror
# events to PostHog (autocapture + session replay). Leave empty to disable PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Public canonical origin: use the stable production host, never a deployment URL.
NEXT_PUBLIC_SITE_URL=https://clipfactory-saas-demeauxa8-1591s-projects.vercel.app
# Optional verification tokens from Google Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
