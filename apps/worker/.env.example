# Worker env. Most values are shared with the API .env; we re-declare so the
# worker can run on a different host than the API if needed.

DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CLIPS=clipfactory-clips
R2_ENDPOINT_URL=https://[ACCOUNT_ID].r2.cloudflarestorage.com

OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001

WORKER_CONCURRENCY=1
WORKER_TMP_DIR=/tmp/clipfactory
WORKER_POLL_INTERVAL=2
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YT_DLP_BIN=yt-dlp

ENV=dev
LOG_LEVEL=INFO

# Cost model (cents). Used for total_cost_estimate_cents logging only — pricing
# from the providers' public pages at the time of writing.
COST_TRANSCRIBE_CENTS_PER_MIN=0.3   # OpenAI gpt-4o-mini-transcribe @ ~$0.003/min
COST_VISION_CENTS_PER_FRAME=0.05
COST_TEXT_CENTS_PER_1K_TOKENS=0.08
