# Worker env. Most values are shared with the API .env; we re-declare so the
# worker can run on a different host than the API if needed.

DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CLIPS=clipfactory-clips
R2_ENDPOINT_URL=https://[ACCOUNT_ID].r2.cloudflarestorage.com
STORAGE_BACKEND=r2
STORAGE_LOCAL_DIR=
# openai (whisper-1, OpenAI direct) | openrouter (OPENROUTER_TRANSCRIBE_MODEL) | mlx_whisper (local Mac)
ASR_BACKEND=openai
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
ASR_FALLBACK_TO_OPENAI=true

OPENAI_API_KEY=sk-...
# Model defaults live in models.lock.toml (single source of truth, provisional —
# pending benchmark 2026-09-29). The values below mirror it; set one only to
# override a stage on this host.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Primary stack via OpenRouter (text reasoning + vision)
OPENROUTER_API_KEY=sk-or-...
# Premium experiments: never put a lab key or MODELS_LOCK_PATH here. Export them
# in the experiment shell only (docs/model-lab.md).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://clipfactory.app
OPENROUTER_APP_NAME=ClipFactory
PRIMARY_TEXT_MODEL=google/gemini-3.8-flash
PRIMARY_VISION_DEEP_MODEL=google/gemini-3.8-flash
VISION_CHEAP_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Fallback / eval stack (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
FALLBACK_TEXT_MODEL=claude-haiku-4-5-20251001
FALLBACK_VISION_MODEL=claude-haiku-4-5-20251001
ENABLE_FALLBACK=true

# Clip judge (native video, one paid call per delivered clip). Off by default.
CLIP_JUDGE_ENABLED=false
CLIP_JUDGE_MODEL=google/gemini-3.8-flash
EVAL_SAMPLE_RATE=0.0

# Pipeline routing: ≥ this duration triggers story-first pipeline
STORY_PIPELINE_THRESHOLD_SECONDS=300

WORKER_CONCURRENCY=1
WORKER_TMP_DIR=/tmp/clipfactory
WORKER_STATE_DIR=
WORKER_POLL_INTERVAL=2
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YT_DLP_BIN=yt-dlp

ENV=dev
LOG_LEVEL=INFO

# Analytics — first-party (analytics_events) always on; PostHog mirror optional.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com

# Cost model (cents), for total_cost_estimate_cents logging only. Leave unset:
# each value is derived from models.lock.toml prices for the configured model.
# COST_TRANSCRIBE_CENTS_PER_MIN=
# COST_VISION_CHEAP_CENTS_PER_FRAME=
# COST_VISION_DEEP_CENTS_PER_FRAME=
# COST_TEXT_CENTS_PER_1K_TOKENS=

# Subprocess bound for ffmpeg/ffprobe/yt-dlp (seconds).
SUBPROCESS_TIMEOUT_SECONDS=900
