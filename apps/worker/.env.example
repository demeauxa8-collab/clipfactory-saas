# Worker env. Most values are shared with the API .env; we re-declare so the
# worker can run on a different host than the API if needed.

DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
REDIS_URL=redis://localhost:6379/0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CLIPS=clipfactory-clips
R2_ENDPOINT_URL=https://[ACCOUNT_ID].r2.cloudflarestorage.com

OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Primary stack via OpenRouter (text reasoning + vision)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://clipfactory.app
OPENROUTER_APP_NAME=ClipFactory
PRIMARY_TEXT_MODEL=deepseek/deepseek-chat-v3.2
PRIMARY_VISION_DEEP_MODEL=google/gemini-2.5-flash
VISION_CHEAP_MODEL=qwen/qwen3-vl-flash

# Fallback / eval stack (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...
FALLBACK_TEXT_MODEL=claude-haiku-4-5-20251001
FALLBACK_VISION_MODEL=claude-haiku-4-5-20251001
ENABLE_FALLBACK=true
EVAL_SAMPLE_RATE=0.0

# Pipeline routing: ≥ this duration triggers story-first pipeline
STORY_PIPELINE_THRESHOLD_SECONDS=300

WORKER_CONCURRENCY=1
WORKER_TMP_DIR=/tmp/clipfactory
WORKER_POLL_INTERVAL=2
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YT_DLP_BIN=yt-dlp

ENV=dev
LOG_LEVEL=INFO

# Analytics — first-party (analytics_events) always on; PostHog mirror optional.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.posthog.com

# Cost model (cents). Used for total_cost_estimate_cents logging only.
COST_TRANSCRIBE_CENTS_PER_MIN=0.3
COST_VISION_CHEAP_CENTS_PER_FRAME=0.02
COST_VISION_DEEP_CENTS_PER_FRAME=0.04
COST_TEXT_CENTS_PER_1K_TOKENS=0.03
