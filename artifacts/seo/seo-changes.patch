+
+export function createPageMetadata(
+  path: string,
+  title: string,
+  description: string,
+  article = false,
+): Metadata {
+  const fullTitle = title.includes(SITE.name)
+    ? title
+    : `${title} | ${SITE.name}`;
+  const url = new URL(path, SITE.url).href;
+  return {
